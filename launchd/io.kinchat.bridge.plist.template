<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.kinchat.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV__/bin/python</string>
        <string>-m</string>
        <string>kinchat</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/kinchat/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/kinchat/launchd.err.log</string>
</dict>
</plist>
